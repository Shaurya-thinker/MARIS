# MARIS Backend Environment Configuration
# Copy this file to backend/.env and fill in the values.
# NEVER commit backend/.env to version control.

# ============================================================
# Copernicus Data Space Ecosystem (CDSE) — Sentinel-1
# ============================================================
# Register at: https://dataspace.copernicus.eu/
# Used for: Sentinel-1 catalogue discovery (Step 1 of wizard)
# and scene download/ingestion (B1 pipeline).
CDSE_USERNAME=
CDSE_PASSWORD=
# Optional: use a pre-obtained access token instead of username/password
# CDSE_ACCESS_TOKEN=

# ============================================================
# Copernicus Climate Data Store (CDS) — ERA5
# ============================================================
# Register at: https://cds.climate.copernicus.eu/
# After registration, copy your UID:key from My Account > API key.
# Used for: ERA5 10 m wind acquisition (Step 2 of wizard / Stage C1).
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# ============================================================
# Copernicus Marine Service (CMEMS)
# ============================================================
# Register at: https://marine.copernicus.eu/
# Used for: GLORYS12V1 near-surface current acquisition (Step 2 / Stage C1).
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ============================================================
# AIS Historical Data
# ============================================================
# Set MARIS_AIS_ADAPTER to the adapter implementation ID.
# The default "unconfigured" adapter raises an error on every query.
# Contact your MARIS administrator to configure a real AIS source.
MARIS_AIS_ADAPTER=unconfigured

# ============================================================
# Storage
# ============================================================
# Directory for acquired NetCDF files and experiment SQLite DB.
# Defaults to: backend/data/
MARIS_DATA_DIR=

# ============================================================
# CORS — Frontend URL
# ============================================================
# Comma-separated list of allowed origins.
# Defaults to localhost:5173, 5174, 3000 when unset.
MARIS_ALLOWED_ORIGINS=http://localhost:5173
