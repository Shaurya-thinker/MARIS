    {
      "type": "Feature",
      "properties": {
        "name": "Ulysse–CSL Virginia oil slick (Corsica), Sentinel-1A SAR, 2018-10-08T05:28Z — georeferenced",
        "incident": "Ulysse–CSL Virginia collision, 7 October 2018, international waters north of Cap Corse, Corsica, France",
        "satellite": "Sentinel-1A",
        "instrument": "C-band Synthetic Aperture Radar (SAR)",
        "acquisition_time_utc": "2018-10-08T05:28:00Z",
        "source": "Contains modified Copernicus Sentinel data (2018), processed by ESA, CC BY-SA 3.0 IGO. Published as \"Oil spill spread\" (copernicus.eu / esa.int).",
        "reported_slick_length_km_first_pass": 20,
        "feature_type": "observed_oil_slick_boundary",
        "boundary_status": "OBSERVED/RECONSTRUCTED — manually digitized from the dark SAR backscatter (damping) signature in the published image. This is NOT an official agency ground-truth mask (no REMPEC/CleanSeaNet/CEDRE vector product was used).",
        "digitization_method": "Dark-pixel (oil damping signature) segmentation of the published SAR image, density-filtered to suppress speckle noise, thin low-contrast segments bridged by hand to preserve the visible continuous slick trace, then contour-simplified. Shape, length, and orientation are scaled/rotated using the image's own embedded 5 km scale bar and north arrow (verified: north = up, no rotation).",
        "georeferencing_status": "CORRECTED (see processing note). Original polygon shape/orientation/scale preserved exactly; a rigid translation (Δlon=+0.36292°, Δlat=+0.04864°) was applied to every vertex to move the polygon from its previous approximate anchor to a position controlled by the official BEA mer collision fix (43°14.9'N / 9°28.7'E) and the Giraglia (Cap Corse tip) lighthouse control point (43.026804°N, 9.405606°E). Absolute accuracy is estimated at roughly ±1-2 km (limited by reliance on a compressed/rotated published graphic rather than the original geocoded SAFE product).",
        "shape_note": "Polygon follows the irregular, branching slick outline (fragmented sheen with a thicker patch near the source end and a thinning drift tail) rather than a simplified line or bounding box. Correction note: close inspection of the source image shows a bright SAR point-target (characteristic hard-target/ship return) at the NARROW SE end of the trace, not the thicker NW end, so the SE end \u2014 not the thick blob \u2014 was used as the source/vessel control point; the thick NW end represents older, more-spread oil furthest along the reported north-westerly drift.",
        "control_points_used": [
          {
            "name": "BEA mer official collision fix (ULYSSE–CSL VIRGINIA impact position)",
            "lat": 43.248333333333335,
            "lon": 9.478333333333333,
            "source": "BEA mer investigation report: 'ULYSSE aborde ... a la position 43°14',9 N / 9°28',7 E'"
          },
          {
            "name": "Phare de la Giraglia (Cap Corse tip control point, used for consistency/orientation check)",
            "lat": 43.026804,
            "lon": 9.405606,
            "source": "Wikipedia: Giraglia lighthouse coordinates 43°01'36\"N 9°24'20\"E"
          },
          {
            "name": "Radar-bright point target at the slick's tail-tip (image-derived control point)",
            "note": "A bright point-target (characteristic SAR ship/hard-target return) sits at the narrow, SE end of the digitized slick outline; this is interpreted as the imaged position of the anchored, collided ULYSSE/CSL VIRGINIA, i.e. the pollution source. This vertex was used as the anchor for the rigid translation onto the BEA mer collision fix."
          }
        ]
      },
